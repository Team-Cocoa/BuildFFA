            <artifactId>wrapper-jvm</artifactId>
            <version>4.0.0-RC9</version> <!-- only needed when bom is not used -->
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>eu.cloudnetservice.cloudnet</groupId>
            <artifactId>platform-inject-api</artifactId>
            <version>4.0.0-RC9</version> <!-- only needed when bom is not used -->
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>eu.cloudnetservice.cloudnet</groupId>
            <artifactId>platform-inject-processor</artifactId>
            <version>4.0.0-RC9</version> <!-- only needed when bom is not used -->
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>eu.cloudnetservice.cloudnet</groupId>
            <artifactId>bridge</artifactId>
            <version>4.0.0-RC9</version> <!-- only needed when bom is not used -->
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>kr.teamcocoa</groupId>
            <artifactId>nick</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/Nick.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>ch.dkrieger</groupId>
            <artifactId>coinsystem</artifactId>
            <version>3.2.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/CoinSystem.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.20</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>kr.teamcocoa</groupId>
            <artifactId>core</artifactId>
            <version>1.0-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/TeamCocoa-Core.jar</systemPath>
        </dependency>

        <dependency>
